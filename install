#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

PATH=$HOME/.cargo/bin:$PATH
if [[ $(uname) == Darwin ]]; then
    brew bundle --file Brewfile
    command -v matugen >/dev/null || cargo install matugen
    [[ $SHELL == */zsh ]] || chsh -s /bin/zsh
fi
for tool in stow tmux zsh starship matugen fzf jq python3; do
    command -v "$tool" >/dev/null || { echo "install: $tool is missing; install it and run ./install again" >&2 && exit 1; }
done

git config core.hooksPath .githooks

if [[ -L ~/.tmux.conf && $(readlink ~/.tmux.conf) == "$PWD"/* ]]; then
    rm ~/.tmux.conf
fi
./link
bin/claude-setup

if [[ ! -f ${XDG_STATE_HOME:-$HOME/.local/state}/theme/colors.json ]]; then
    bin/theme '#b86b4f'
    echo "install: seeded default colours; change them with: theme <image>"
fi

echo "install: done. Open a new kitty window, then start tmux."
