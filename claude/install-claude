#!/usr/bin/env bash
# Sets up ~/.claude from this folder: links, settings, plugins, skills.
# Usage: claude/install-claude   (called by ./install)

LINKS="CLAUDE.md rules/context7.md rules/working-style.md commands/commit-message.md statusline-command.sh"

link_files() {
    local dir=$1 f target
    for f in $LINKS; do
        target=$HOME/.claude/$f
        mkdir -p "$(dirname "$target")"
        [ -L "$target" ] && [ "$(readlink "$target")" = "$dir/$f" ] && continue
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            mv "$target" "$target.bak-$(date +%Y%m%d%H%M%S)"
            echo "install: backed up $target"
        fi
        ln -sfn "$dir/$f" "$target"
    done
}

merge_settings() {
    local private=$2
    [ -f "$private" ] || private=/dev/null
    jq -s '
        def dedupe: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);
        .[0] as $s | (.[1] // {}) as $p
        | ($s * $p)
        | if (.autoMode | type) == "object" then
              .autoMode |= with_entries(
                  .key as $k
                  | if ((($s.autoMode // {})[$k] | type) == "array") or ((($p.autoMode // {})[$k] | type) == "array")
                    then .value = (((($s.autoMode // {})[$k]) // []) + (((($p.autoMode // {})[$k]) // [])) | dedupe)
                    else . end)
          else . end' "$1" "$private"
}

split_private() {
    jq -s '
        def minus($s):
            if . == $s then null
            elif type == "object" and ($s | type) == "object" then
                with_entries(.key as $k | .value |= minus($s[$k])) | with_entries(select(.value != null))
                | if . == {} then null else . end
            elif type == "array" and ($s | type) == "array" then
                [.[] | select(. as $x | $s | index([$x]) | not)] | if . == [] then null else . end
            else . end;
        .[1] as $shared | (.[0] | minus($shared)) // {}' "$1" "$2"
}

sha_of() { shasum "$1" | cut -d' ' -f1; }

write_settings() {
    local dir=$1 out=$HOME/.claude/settings.json record=$HOME/.claude/.settings.generated.sha new bak
    mkdir -p "$HOME/.claude"
    new=$(merge_settings "$dir/settings.shared.json" "$HOME/.claude/settings.private.json") || return 1
    if [ -f "$out" ] && [ "$(sha_of "$out")" != "$(cat "$record" 2>/dev/null)" ] &&
        [ "$(jq -S . "$out")" != "$(jq -S . <<<"$new")" ]; then
        bak=$out.bak-$(date +%Y%m%d%H%M%S)
        cp "$out" "$bak"
        echo "install: settings.json changed locally; backed up to $bak; keys that differ:"
        jq -rn --slurpfile a "$out" --argjson b "$new" \
            '$a[0] as $a | [($a | keys) + ($b | keys) | unique[] | select($a[.] != $b[.])] | join(", ")'
    fi
    printf '%s\n' "$new" >"$out"
    sha_of "$out" >"$record"
}

install_plugins() {
    local settings=$HOME/.claude/settings.json known=$HOME/.claude/plugins/known_marketplaces.json
    local installed=$HOME/.claude/plugins/installed_plugins.json markets plugins item answer
    if ! command -v claude >/dev/null; then
        echo "install: claude CLI not found; install it, then re-run ./install for plugins"
        return 0
    fi
    [ -f "$known" ] || known=/dev/null
    [ -f "$installed" ] || installed=/dev/null
    markets=$(jq -r --slurpfile k "$known" '($k[0] // {}) as $k
        | .extraKnownMarketplaces // {} | to_entries[] | select($k[.key] == null) | .value.source.repo // empty' "$settings")
    plugins=$(jq -r --slurpfile i "$installed" '(($i[0] // {}).plugins // {}) as $i
        | .enabledPlugins // {} | to_entries[] | select(.value == true and $i[.key] == null) | .key' "$settings")
    [ -n "$markets$plugins" ] || return 0
    echo "install: about to fetch third-party Claude plugins (they run with your Claude permissions):"
    for item in $markets; do echo "  marketplace  $item"; done
    for item in $plugins; do echo "  plugin       $item"; done
    read -r -p "Fetch them now? [y/N] " answer
    case $answer in y | Y | yes) ;; *) echo "install: skipped plugins; re-run ./install to add them later" && return 0 ;; esac
    for item in $markets; do
        claude plugin marketplace add "$item" || echo "install: could not add marketplace $item"
    done
    for item in $plugins; do
        claude plugin install "$item" --scope user || echo "install: could not install plugin $item"
    done
}

install_skills() {
    local src
    if ! command -v npx >/dev/null; then
        echo "install: npx not found; install Node.js, then re-run ./install for skills"
        return 0
    fi
    while IFS= read -r src; do
        [ -n "$src" ] || continue
        npx -y skills add "$src" -g -y --skill '*' || echo "install: could not add skills from $src"
    done <"$1/skills.txt"
    echo "install: for graphify run: uv tool install graphifyy && graphify install --platform claude"
    echo "install: for the find-docs skill run: npx ctx7 setup --cli"
}

main() {
    local dir
    dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    "$dir/privacy-check" "$(dirname "$dir")" || { echo "install: fix the above before installing Claude config" && return 1; }
    link_files "$dir"
    write_settings "$dir"
    install_plugins
    install_skills "$dir"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@" || exit 1; fi
